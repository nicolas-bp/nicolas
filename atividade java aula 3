class Cartao {
    int numero = 0;
    int limite = 0;
    float saldoDisponivel = 0;
    
    void register(){
        int compra1 = 1000;
        System.out.println("compra no valor de:" + compra1);
        saldoDisponivel = (compra1 - saldoDisponivel);
        System.out.println("saldo disponivel:" +saldoDisponivel);
    }
    void verif(){
        int compra2 = 2000;
        System.out.println("compra no valor de:" + compra2);
        if(compra2<saldoDisponivel){
            saldoDisponivel = (compra2 - saldoDisponivel);
